# ==============================================================================
# Telbot - Public Template Configuration
# Copy this file to `.env` for local runs, or set these in your cloud host.
# NEVER commit `.env` or real API keys to git!
# ==============================================================================

# --- REQUIRED: Telegram & Primary OpenAI-Compatible AI Provider ---
BOT_TOKEN=your_telegram_bot_token_here
AI_API_KEY=your_api_key_here

# Provider Examples (any OpenAI-compatible /v1 endpoint works):
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1          | AI_MODEL=gpt-4o-mini
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1       | AI_MODEL=deepseek/deepseek-chat-v3-0324:free
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1     | AI_MODEL=llama-3.3-70b-versatile
#   DeepSeek:   AI_BASE_URL=https://api.deepseek.com/v1        | AI_MODEL=deepseek-chat
#   Ollama:     AI_BASE_URL=http://host.docker.internal:11434/v1 | AI_MODEL=llama3.2 (set AI_API_KEY=ollama)
AI_BASE_URL=https://api.openai.com/v1
# Supports optional comma-separated failover list (e.g. model-1,model-2)
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

# --- OPTIONAL: Fallback AI Provider ---
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=
# Supports optional comma-separated failover list (e.g. model-a,model-b)
FALLBACK_AI_MODEL=

# --- OPTIONAL: Vision & Image Generation Models (on your primary AI_BASE_URL) ---
# Set VISION_MODEL (e.g. gpt-4o-mini) to analyze photos without Cloudflare keys.
VISION_MODEL=
IMAGE_GEN_MODEL=

# --- OPTIONAL: Extra Cloud Services ---
# Tavily improves web search & extraction; otherwise DuckDuckGo + Crossref Open-Access is used.
TAVILY_API_KEY=
# Cloudflare Workers AI (emergency LLM fallback, Vision, and FLUX image generation)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# OCR.space API key (optional secondary OCR; leave blank to disable external OCR uploads)
OCR_API_KEY=
# Optional Supabase cloud sync (leave blank to use built-in SQLite in data/bot.db)
SUPABASE_URL=
SUPABASE_KEY=

# --- ACCESS CONTROL & GROUP ETIQUETTE ---
# Comma-separated Telegram User IDs for admins (run /id in chat to find yours).
# Fail-closed: if empty, NO ONE has admin privileges (/model, /ban, /admin).
ADMIN_USERS=
ALLOW_DMS=true
ALLOW_GROUPS=true
# Optional allowlist of negative group chat IDs. Leave empty for open public groups.
ALLOWED_GROUPS=
# Optional static blocklists (comma-separated IDs)
BLOCKED_USERS=
BLOCKED_GROUPS=
# Group trigger mode:
#   mention_or_reply = respond only when @mentioned, replied to, /ask, or /search (recommended)
#   all              = respond to every message in the group (requires BotFather /setprivacy Disable)
GROUP_TRIGGER_MODE=mention_or_reply

# --- PUBLIC-SAFETY RATE LIMITS & DAILY QUOTAS (0 = unlimited for daily quotas) ---
RATE_LIMIT_BURST=3
RATE_LIMIT_BURST_WINDOW=10
RATE_LIMIT_PER_MINUTE=6
GROUP_RATE_LIMIT_PER_MINUTE=20
DAILY_MSG_LIMIT=50
DAILY_SEARCH_LIMIT=15
DAILY_IMAGE_LIMIT=5
DAILY_FILE_LIMIT=10
ADMIN_BYPASS_LIMITS=true

# --- RESOURCE BOUNDS & DATA RETENTION ---
MAX_INPUT_CHARS=4000
MAX_FILE_BYTES=10000000
MAX_URL_BYTES=500000
MAX_HISTORY_MESSAGES=30
HISTORY_RETENTION_DAYS=30

# --- FEATURE FLAGS ---
ENABLE_WEB_SEARCH=true
ENABLE_URL_READER=true
ENABLE_JINA_READER=true
ENABLE_VISION=true
ENABLE_OCR_SPACE=true
ENABLE_FILE_GEN=true
ENABLE_IMAGE_GEN=true
ENABLE_POLLINATIONS_FALLBACK=true
ENABLE_CHARTS=true
ENABLE_DM_PROFILE_MEMORY=true

# --- STORAGE & WEBHOOK DEPLOYMENT ---
# Leave WEBHOOK_URL empty for local polling. Render/Railway hostnames are auto-detected.
DATA_DIR=
DB_PATH=
ALLOWED_WEB_PORTS=80,443
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=10000
LOG_LEVEL=INFO
